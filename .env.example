# Database Configuration
LAYER_BASE_CONNECTION_STRING=postgresql://username:password@your-pooler-host.dev/dbname?sslmode=require

# Google OAuth2 Credentials
GOOGLE_REDIRECT_URI=http://localhost:8501
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OpenAI Configuration
# Existing setups may use LAYER_BASE for the OpenAI key instead.
# A nonempty OPENAI_API_KEY takes priority over LAYER_BASE.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1

# Groq Configuration (Fallback / Primary Alternative)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Scheduled Question Generation Batch Size
QUESTION_GENERATION_BATCH_SIZE=100
